# ==============================================================================
# Plottershub - Environment Configuration Example
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ------------------------------------------------------------------------------
# PostgreSQL Database (Neon Preferred)
# ------------------------------------------------------------------------------
# Pooled connection string (used by app runtime)
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/plottershub?sslmode=require&pgbouncer=true"

# Direct connection string (used by Prisma migrations)
DIRECT_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/plottershub?sslmode=require"

# ------------------------------------------------------------------------------
# Application Security & Token Encryption
# ------------------------------------------------------------------------------
# Random 32+ byte string used for JWT session signing & CSRF protection
AUTH_SECRET="change-this-to-a-super-secret-auth-key-min-32-chars"

# 32-byte (256-bit) Hex-encoded key for AES-256-GCM social token encryption
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ------------------------------------------------------------------------------
# Redis / BullMQ Background Job Queue
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# Object Storage (Cloudflare R2 / S3 Compatible)
# ------------------------------------------------------------------------------
STORAGE_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY="your-r2-access-key-id"
STORAGE_SECRET_KEY="your-r2-secret-access-key"
STORAGE_BUCKET="plottershub-media"
STORAGE_PUBLIC_URL="https://media.plottershub.com"

# ------------------------------------------------------------------------------
# Google / YouTube OAuth
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/social/youtube/callback"

# ------------------------------------------------------------------------------
# TikTok OAuth & Content Posting API
# ------------------------------------------------------------------------------
TIKTOK_CLIENT_KEY="your-tiktok-client-key"
TIKTOK_CLIENT_SECRET="your-tiktok-client-secret"
TIKTOK_REDIRECT_URI="http://localhost:3000/api/social/tiktok/callback"

# ------------------------------------------------------------------------------
# Meta / Instagram Graph API
# ------------------------------------------------------------------------------
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"
META_REDIRECT_URI="http://localhost:3000/api/social/instagram/callback"

# ------------------------------------------------------------------------------
# AI Provider Integration
# ------------------------------------------------------------------------------
AI_API_KEY="your-ai-provider-api-key"
